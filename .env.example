# اختیاری — اگر این فایل را کپی نکردی هم پروژه با پیش‌فرض‌ها کار می‌کند
# برای ساخت:  copy .env.example .env   (ویندوز)   یا   cp .env.example .env

PORT=7000
LOG_LEVEL=info
ADDON_MODE=full
ADDON_VERSION=0.1.3

# اختیاری — پیش‌فرض همان آدرس عمومی است
# F2MEDIA_BASEURL=https://www.film2med.top

PROVIDER_TIMEOUT_MS=15000

# CinemaGraphy-next — copy to .env for local Node

PORT=7000
LOG_LEVEL=info
DEV_MODE=0

# full | streams | catalogs
ADDON_MODE=full

ADDON_NAME=سینماگرافی
ADDON_VERSION=0.1.0

META_LANG=fa
UI_LANG=fa

# Optional — never required for base streams
# TMDB_API_KEY=

# Provider base URLs (empty = off). Real scrapers not in scaffold yet.
# F2MEDIA_BASEURL=https://www.film2med.top

# Comma list to restrict providers; empty = all with baseUrl
# ENABLED_PROVIDERS=f2media

# Demo stub provider
# STUB_ENABLE=1

PROVIDER_TIMEOUT_MS=15000

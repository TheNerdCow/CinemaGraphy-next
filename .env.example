# CinemaGraphy Next — copy to .env
PORT=7000
ADDON_VERSION=0.2.6
LOG_LEVEL=info

# F2Media site (change if domain rotates)
F2MEDIA_BASEURL=https://www.film2med.top

# Optional — free key from https://www.themoviedb.org/settings/api
# Without this, posters fall back to Cinemeta/metahub only.
TMDB_API_KEY=

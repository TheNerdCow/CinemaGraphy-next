# CinemaGraphy Next — copy to .env (all keys optional except as noted)
PORT=7000
ADDON_VERSION=0.4.7
LOG_LEVEL=info

# full | streams | catalogs
# ADDON_MODE=full

# F2Media site (domain rotates — use current live host)
F2MEDIA_BASEURL=https://www.myf2ms.top

# Cinamatic / AslMoviez (optional overrides)
# CINAMATIC_BASEURL=https://cinamatic.top
# ASLMOVIEZ_BASEURL=https://aslmoviez.com

# AvaMovie (subscription)
# Inside Iran use avadel.top (unfiltered). avamovie.shop is often filtered in IR.
# Outside Iran avadel.top may timeout; addon tries both and keeps the useful one.
AVAMOVIE_BASEURL=https://avadel.top
# Paste full Cookie header from logged-in browser on avadel.top
# AVAMOVIE_COOKIE=PHPSESSID=...; wordpress_logged_in_xxx=...

# Optional provider timeout (ms)
# PROVIDER_TIMEOUT_MS=22000

# Metadata uses public Cinemeta + MetaHub (no API key required).

{
  "name": "cinemagraphy-next",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "description": "Independent modular CinemaGraphy rewrite (Stremio).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first src/runtimes/node/server.js",
    "dev": "node --dns-result-order=ipv4first --watch src/runtimes/node/server.js",
    "test": "node --test tests/unit/*.test.js tests/providers/*.test.js",
    "check": "node --check src/runtimes/node/server.js"
  },
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
